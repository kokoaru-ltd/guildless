# Optional Sakana subscription provider. Do not commit the real value.
SAKANA_API_KEY=
SAKANA_BASE_URL=https://api.sakana.ai
SAKANA_MODEL=fugu-ultra

# Subscription/local commands and models.
CLAUDE_COMMAND=claude
CLAUDE_MODEL=opus
CODEX_COMMAND=codex
CODEX_MODEL=default
OLLAMA_COMMAND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEEPSEEK_MODEL=deepseek-r1:14b

# Fully local speech-to-text. The model downloads once, then remains local.
GUILDLESS_WHISPER_MODEL=small
# auto attempts CUDA and safely falls back to CPU when CUDA 12/cuDNN 9 DLLs are unavailable.
GUILDLESS_WHISPER_DEVICE=auto
GUILDLESS_WHISPER_MODEL_DIR=D:\guildless_council\.runtime\whisper_models

# ANTHROPIC_API_KEY must be unset. If it is non-empty, ClaudeProvider stops.
# OPENAI_API_KEY is never forwarded to Codex CLI; ChatGPT login is required.

COUNCIL_PROVIDER_TIMEOUT_SECONDS=300
COUNCIL_MAX_RETRIES=2
COUNCIL_MAX_CONTEXT_BYTES=2000000
COUNCIL_LOCAL_REPETITIONS=3
